#include<stdio.h>
int main()
{
int m=2,n=3;
printf("\n Bitwiseoperators\n");
printf("m&n=%d\n",m&n);
printf("m|n=%d\n",m|n);
printf("m^n=%d\n",m^n);
printf("m>>n=%d\n",m>>n);
printf("m<<n=%d\n",m<<n);
return 0;
}
