#include<stdio.h>
int main()
{
int a=2,b=3;
printf("\n Arithemetic Operators\n");
printf("sum=%d\n",a+b);
printf("Difference=%d\n",a-b);
printf("Product=%d\n",a*b);
printf("division=%d\n",a/b);
printf("modulus=%d\n",a%b);
return 0;
}
